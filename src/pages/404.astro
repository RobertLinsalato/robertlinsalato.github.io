---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="404 | NOT FOUND">
  <main>
    <Header activePage="404" />

    <section class="panel-container">
      <div class="panel-header">
        <h2>/// SYS.ERROR_404</h2>
      </div>
      <div class="panel-body about-content">
        <h1><span class="new-alert">!!! SYS.ERROR_404 !!!</span></h1>
        <p>
          The requested system path could not be resolved. The file may have been moved, deleted, or never existed in the archive.
        </p>
        
        <div style="margin-top: 2rem;">
          <a href="/" class="terminal-btn">
            > RETURN_TO_HOME
          </a>
        </div>
        <hr class="fullBreak">
        <div class="hardware-code-panel">
          <code>
            <span class="code-line">I have wandered like a <span class="token-amber">lost sheep</span>;</span>
            <span class="code-line">  seek out your servant,</span>
            <span class="code-line">  for <span class="token-highlight-text">I do not forget</span> your commandments.</span>
            <span class="code-line token-comment"> /// Psalms 119:176 (NABRE)</span>
          </code>
        </div>
      </div>
    </section>
  </main>
</Layout>
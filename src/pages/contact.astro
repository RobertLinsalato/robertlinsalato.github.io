---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Robert Linsalato | Contact">
  <main>
    <Header activePage="contact" />
    <section class="panel-container">
      <div class="panel-header">
        <h2>/// ESTABLISH CONNECTION</h2>
      </div>
      
      <div class="panel-body contact-content">
        <div class="contact-row">
          <span class="label">EMAIL_</span>
          <a href="mailto:contact@robertlinsalato.com" class="value link">contact@robertlinsalato.com</a>
        </div>

        <div class="contact-row">
          <span class="label">LINKEDIN_</span>
          <a href="https://linkedin.com/in/robert-linsalato-jr" target="_blank" class="value link">Robert Linsalato Jr.</a>
        </div>
      </div>
    </section>

    <section class="panel-container">
      <div class="panel-header">
        <h2>/// SOCIALIZE WITH ME</h2>
        </div>
          <div class="panel-body contact-content">
            <div class="contact-row">
              <span class="label">INSTAGRAM_</span>
              <a href="https://instagram.com/robbielinsalato" target="_blank" class="value link">@robbielinsalato</a>
            </div>

            <div class="contact-row">
              <span class="label">GITHUB_</span>
              <a href="https://github.com/robertlinsalato" target="_blank" class="value link">github.com/robertlinsalato</a>
            </div>

            <div class="contact-row">
              <span class="label">ITCH.IO_</span>
              <a href="https://thatfish4261.itch.io" target="_blank" class="value link">@thatfish4261</a>
            </div>
            
            <div class="contact-row">
              <span class="label">ARTSTATION_</span>
              <a href="https://www.artstation.com/robertlinsalato" target="_blank" class="value link">@Robert Linsalato</a>
            </div>

            <div class="contact-row">
              <span class="label">LETTERBOXD_</span>
              <a href="https://letterboxd.com/RobertLinsalato" target="_blank" class="value link">@RobertLinsalato</a>
            </div>

          <div class="contact-row">
            <span class="label">TWITCH_</span>
            <a href="https://twitch.tv/that__fish" target="_blank" class="value link">@that__fish</a>
          </div>
        </div>
    </section>

    <section class="panel-container">
      <div class="panel-header">
        <h2>/// RESUME</h2>
      </div>
      <div class="panel-body contact-content">
        <div class="hardware-carousel-wrapper pdf-container">
          <span class="panel-tag">/// RESUME.PDF</span>
          <embed src="/pdf/RL Resume.pdf" 
          type="application/pdf" 
          width="100%" 
          height="600px" 
          class="pdf-embed" />
        </div>
        <div class="contact-row">
          <span class="label">DOWNLOAD_</span>
          <a href="/pdf/RL Resume.pdf" class="terminal-btn" target="_blank">> VIEW RESUME</a>        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .contact-content { padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }
  
  .contact-row { display: flex; align-items: baseline; font-size: 0.95rem; }
  .label { color: #71717a; width: 120px; font-weight: 600; }
  .value { color: #e4e4e7; }
  
  .link { text-decoration: none; transition: color 0.15s ease; }
  .link:hover { color: var(--accent); text-decoration: underline; }
  
  .pdf-container { padding-bottom: 1rem; }
  .pdf-embed { border: 1px solid #33373b; background-color: var(--bg); display: block; }
</style>
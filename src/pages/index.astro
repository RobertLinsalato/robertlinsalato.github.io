---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CatalogueItem from '../components/CatalogueItem.astro';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const allDevlogs = await getCollection('devlogs');

// Sort devlogs by newest date first, then highest logNumber
const sortedDevlogs = allDevlogs.sort((a, b) => {
  const dateDiff = new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  return dateDiff !== 0 ? dateDiff : b.data.logNumber - a.data.logNumber;
});

const allProjectsCount = sortedProjects
  .slice(0, 8); // Limit to the 8 latest items for the homepage

// Pre-compute values for the 3 latest devlogs
const now = new Date().getTime();
const thirtyDaysInMs = 30 * 24 * 60 * 60 * 1000;

const allDevlogsCount = sortedDevlogs
  .slice(0, 3)
  .map(log => {
    const logTime = new Date(log.data.date).getTime();
    return {
      ...log,
      isNew: (now - logTime) <= thirtyDaysInMs,
      paddedNum: String(log.data.logNumber).padStart(2, '0'),
      formattedDate: new Date(log.data.date).toLocaleDateString('en-GB', {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
      }),
    };
  });
---

<Layout title="Robert Linsalato | Portfolio">
  <main>
    <Header activePage="home" />

    <img class="header-gif" src="/images/home/Ver2.gif">

    <section id="about" class="panel-container">
      <div class="panel-header"><h2><a href="/about">/// ABOUT</a></h2></div>
      <div class="panel-body bio-text">
        <p>I am a game developer and audio engineer focused on building interactive systems, sound design, and live audio engineering. Read more <a href="/about">here</a>.</p>
      </div>
    </section>

    <section id="projects" class="panel-container">
      <div class="panel-header">
        <h2><a href="/projects">/// RECENT_PROJECTS</a></h2>
        <span class="count">{allProjectsCount.length} ITEMS</span>
      </div>
      <div class="panel-body">
        {allProjectsCount.map((item) => (
          <CatalogueItem 
            date={item.data.date} 
            title={item.data.title} 
            href={item.data.externalUrl || `/projects/${item.id}`} 
            badge={item.data.badge} 
            categories={item.data.categories}
            tags={item.data.tags} 
          />
        ))}
      </div>
    </section>

    <section id="devlogs" class="panel-container">
      <div class="panel-header">
        <h2><a href="/devlogs">/// RECENT_DEVLOGS</a></h2>
        <span class="count">{allDevlogsCount.length} LOGS</span>
      </div>
      <div class="panel-body">
        {allDevlogsCount.map((log) => (
          <div class="catalogue-row">
            <div class="main-info">
              <span class="date">[{log.formattedDate}]</span>

              {log.isNew && <span class="new-alert">!!! NEW !!!</span>}

              <a href={`/devlogs/${log.id}`} class="title-link">{log.data.title}</a>

              <div class="tags-container">
                <span class="tech-tag">[DEVLOG #{log.paddedNum}]</span>
              </div>

              <div class="categories-wrapper">
                <span class="category-tag category-devlog">{log.data.project}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>
</Layout>

<style>
  .header-gif { width: 100%; max-width: 100%; height: auto; margin-bottom: 2rem; }
  .bio-text p { color: #a1a1aa; font-size: 0.875rem; line-height: 1.6; padding: 0.5rem 0; }
</style>
---
const { activePage } = Astro.props;
---

<header class="site-header" transition:name="terminal-header">
  <div class="brand-container">
    <a href="/"><img src="/images/profile.jpg" alt="Robert Linsalato" class="header-profile-img" /></a>
    <div class="brand-text">
      <h1 class="brand-name">ROBERT LINSALATO JR</h1>
      <p class="brand-subtitle">Game Developer & Audio Engineer</p>
    </div>
  </div>

  <nav class="nav-links">
    <a href="/" class={activePage === 'home' ? 'active' : ''}>[HOME]</a>
    <a href="/about" class={activePage === 'about' ? 'active' : ''}>[ABOUT]</a>
    
    <div class="dropdown" id="projects-dropdown">
      <a 
        href="/projects" 
        id="projects-toggle"
        class={activePage === 'projects' || activePage === 'games' || activePage === 'audio' || activePage === 'other' ? 'active' : ''}
        aria-haspopup="true"
        aria-expanded="false"
      >
        [PROJECTS] ▼
      </a>
      
      <div class="dropdown-content">
        <a href="/projects" class="terminal-btn">> ALL_PROJECTS</a>
        <a href="/games" class="terminal-btn">> GAMES</a>
        <a href="/audio" class="terminal-btn">> AUDIO</a>
        <a href="/other" class="terminal-btn">> OTHER</a>
      </div>
    </div>

    <a href="/devlogs" class={activePage === 'devlogs' ? 'active' : ''}>[DEVLOGS]</a>
    <a href="/contact" class={activePage === 'contact' ? 'active' : ''}>[CONTACT]</a>
  </nav>
</header>

<script>
  function setupMobileDropdown() {
    const dropdown = document.getElementById('projects-dropdown');
    const toggleBtn = document.getElementById('projects-toggle');
    if (!dropdown || !toggleBtn) return;

    const handleToggle = (e: MouseEvent) => {
      // Check if user is on a touch/pointer device without hover capability OR under standard mobile width
      const isMobile = window.matchMedia('(hover: none), (max-width: 600px)').matches;
      
      if (isMobile) {
        e.preventDefault(); // Stop immediate navigation to /projects so menu toggles
        const isOpen = dropdown.classList.toggle('is-open');
        toggleBtn.setAttribute('aria-expanded', String(isOpen));
      }
    };

    // Close when tapping anywhere outside
    const handleOutsideClick = (e: MouseEvent) => {
      if (!dropdown.contains(e.target as Node)) {
        dropdown.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
      }
    };

    toggleBtn.addEventListener('click', handleToggle);
    document.addEventListener('click', handleOutsideClick);
  }

  document.addEventListener('DOMContentLoaded', setupMobileDropdown);
  document.addEventListener('astro:page-load', setupMobileDropdown);
</script>

<style>
  .site-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
    position: relative;
  }

  @media (min-width: 600px) {
    .site-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .brand-container {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header-profile-img {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border: 1px solid var(--border);
    background-color: var(--panel);
    filter: grayscale(75%) contrast(1.1);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .brand-name {
    font-size: 1.1rem;
    font-weight: bold;
    color: #e4e4e7;
    margin: 0;
    letter-spacing: 0.08em;
  }

  .brand-subtitle {
    font-size: 0.75rem;
    color: var(--accent);
    margin: 0;
    letter-spacing: 0.05em;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .nav-links a {
    font-size: 0.85rem;
    color: #a1a1aa;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--accent);
  }

  /* --- DROPDOWN CONTAINER --- */
  .dropdown {
    position: relative;
    display: inline-block;
    padding-bottom: 10px;
    z-index: 990;
  }

  /* --- DROPDOWN MENU PANEL --- */
  .dropdown-content {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background-color: var(--panel);
    border: 1px solid var(--border);
    z-index: 1000; 
    min-width: 180px;
    box-shadow: 4px 4px 0px rgba(0, 0, 0, 0.5);
    flex-direction: column;
  }

  /* Only desktop mice trigger hover */
  @media (hover: hover) and (pointer: fine) {
    .dropdown:hover .dropdown-content {
      display: flex;
    }
  }

  .dropdown.is-open .dropdown-content {
    display: flex;
  }

  .dropdown-content .terminal-btn {
    border: none;
    border-bottom: 1px dashed var(--border);
    box-shadow: none; 
    justify-content: flex-start; 
    border-radius: 0;
    margin: 0;
    width: 100%;
    z-index: 999;
  }

  .dropdown-content .terminal-btn:last-child {
    border-bottom: none;
  }

  .dropdown-content .terminal-btn:hover {
    transform: none;
    background-color: #222528;
  }
</style>